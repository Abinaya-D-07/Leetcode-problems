bool isPalindrome(char* s) {
    char t[strlen(s)+1];
    int ind=0;
    for(int i=0; s[i]!='\0'; i++){
        if(isalnum(s[i])){
         t[ind++]=tolower(s[i]);
        }
    }
        int l=0,r=ind-1;
        while(l<r){
            if(t[l]!=t[r]) return false; 
            l++;
            r--;
    }
    return true;

}

