char findTheDifference(char* s, char* t) {
    int freq[26];
    for(int i=0; i<26; i++) freq[i]=0;
    for(int i=0; s[i]!='\0'; i++) freq[s[i]-'a']++;
    for(int i=0; t[i]!='\0'; i++) freq[t[i]-'a']--;
    for(int i=0; i<26; i++){
        if(freq[i]!=0)
        return (i+'a');
    }
    return 0;
}
