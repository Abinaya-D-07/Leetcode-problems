double findMaxAverage(int* nums, int numsSize, int k) {
    int sum=0,max=0;
    for(int i=0; i<k; i++){
        sum+=nums[i];
    }
    max=sum;
     for(int i=0; i<numsSize-k; i++){
        sum-=nums[i];
        sum+=nums[i+k];
        if(sum>max)
        max=sum;
     }
     return (double)max/k;
}
