int firstMissingPositive(int* nums, int numsSize) {
    int hash[numsSize+1];
    for(int i=0; i<=numsSize; i++){
        hash[i]=0;
    }

    for(int i=0; i<numsSize; i++){
        if(nums[i]>0 && nums[i]<=numsSize)
        hash[nums[i]]++;
    }

    for(int i=1; i<=numsSize; i++){
        if(hash[i]==0)
        return i;
    }
    return numsSize+1;
}
