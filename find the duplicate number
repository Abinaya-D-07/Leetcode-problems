int findDuplicate(int* nums, int numsSize) {
    int hash[numsSize+1];

    for(int i=0; i<numsSize; i++)
    hash[i]=0;

    for(int i=0; i<numsSize; i++)
    hash[nums[i]]++;

    int res;
    
    for(int i=1; i<numsSize; i++){
        if(hash[i]>1){
           res=i;
        }
    }
    return res;
}
