int equalSubstring(char* s, char* t, int maxCost) {
    int l=0,r=0,cost=0,maxlen=0;
    while(s[r]!='\0'){
        cost+=abs(s[r]-t[r]);
        while(cost>maxCost){
            cost-=abs(s[l]-t[l]);
            l++;
        }
        int len=r-l+1;
        if(len>maxlen) maxlen=len;
        r++;
    }
    return maxlen;
}
